{
  "name": "react-native-turbo-lite",
  "version": "0.1.0",
  "description": "A small Rails Turbo document, Frame, form, and same-request Stream runtime for React Native",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check src test example scripts package.json tsconfig.json tsconfig.build.json biome.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "example:check": "tsc -p example/tsconfig.json --noEmit",
    "package:check": "node scripts/check-package.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "check": "npm run lint && npm run typecheck && npm run test && npm run example:check && npm run build && npm run package:check && npm run pack:dry-run",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noscrubs-dev/react-native-turbo-lite.git"
  },
  "bugs": {
    "url": "https://github.com/noscrubs-dev/react-native-turbo-lite/issues"
  },
  "homepage": "https://github.com/noscrubs-dev/react-native-turbo-lite#readme",
  "keywords": [
    "hotwire",
    "rails",
    "react-native",
    "sdui",
    "turbo"
  ],
  "author": "NoScrubs",
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "peerDependencies": {
    "react": ">=18.3.0",
    "react-native": ">=0.74.0"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "dependencies": {
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.6",
    "react": "^19.1.0",
    "react-dom": "^19.2.8",
    "react-native": "^0.87.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.0"
  },
  "packageManager": "npm@11.5.2"
}
